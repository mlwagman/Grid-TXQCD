<?xml version="1.0"?>
<!--
  HMC trajectory comparison: Nf=2+1 analog of Grid's gen_qcd_cfgs_2plus1 setup.
  Light: TwoFlavour Schur PF (det²) + LogDet num_flavors=2.
  Strange: 1× rational num_pf=1 (det^1) + LogDet num_flavors=1.
  Both at mass=-0.2450 (degenerate ensemble).
  Weak-field start, MN2 with multi-rate gauge sub-integrator.

  Substitute @MDS@, @SAVE_PREFIX@, @SEED@.
-->
<Params>
  <MCControl>
    <Cfg>
      <cfg_type>WEAK_FIELD</cfg_type>
      <cfg_file>DUMMY</cfg_file>
    </Cfg>
    <RNG>
      <Seed><elem>@SEED@</elem><elem>0</elem><elem>0</elem><elem>0</elem></Seed>
    </RNG>
    <StartUpdateNum>0</StartUpdateNum>
    <NWarmUpUpdates>0</NWarmUpUpdates>
    <NProductionUpdates>50</NProductionUpdates>
    <NUpdatesThisRun>50</NUpdatesThisRun>
    <SaveInterval>5</SaveInterval>
    <SavePrefix>@SAVE_PREFIX@</SavePrefix>
    <SaveVolfmt>SINGLEFILE</SaveVolfmt>
    <ReproCheckP>false</ReproCheckP>
    <ReverseCheckP>false</ReverseCheckP>
    <ReverseCheckFrequency>1000000</ReverseCheckFrequency>
    <InlineMeasurements>
      <elem>
        <Name>PLAQUETTE</Name>
        <Frequency>1</Frequency>
        <Param><version>2</version></Param>
        <NamedObject><gauge_id>default_gauge_field</gauge_id></NamedObject>
      </elem>
    </InlineMeasurements>
  </MCControl>

  <HMCTrj>
    <Monomials>

      <elem>
        <Name>N_FLAVOR_LOGDET_EVEN_EVEN_FERM_MONOMIAL</Name>
        <FermionAction>
          <FermAct>CLOVER</FermAct>
          <Mass>-0.2450</Mass>
          <clovCoeff>1.24930970916466</clovCoeff>
          <ZeroEnergy>0</ZeroEnergy>
          <AnisoParam>
            <anisoP>false</anisoP><t_dir>3</t_dir><xi_0>1</xi_0><nu>1</nu>
          </AnisoParam>
          <FermState>
            <Name>STOUT_FERM_STATE</Name>
            <rho>0.125</rho><n_smear>1</n_smear><orthog_dir>-1</orthog_dir>
            <FermionBC>
              <FermBC>SIMPLE_FERMBC</FermBC>
              <boundary>1 1 1 -1</boundary>
            </FermionBC>
          </FermState>
        </FermionAction>
        <num_flavors>2</num_flavors>
        <NamedObject><monomial_id>HMC::logdet_light</monomial_id></NamedObject>
      </elem>

      <elem>
        <Name>N_FLAVOR_LOGDET_EVEN_EVEN_FERM_MONOMIAL</Name>
        <FermionAction>
          <FermAct>CLOVER</FermAct>
          <Mass>-0.2450</Mass>
          <clovCoeff>1.24930970916466</clovCoeff>
          <ZeroEnergy>0</ZeroEnergy>
          <AnisoParam>
            <anisoP>false</anisoP><t_dir>3</t_dir><xi_0>1</xi_0><nu>1</nu>
          </AnisoParam>
          <FermState>
            <Name>STOUT_FERM_STATE</Name>
            <rho>0.125</rho><n_smear>1</n_smear><orthog_dir>-1</orthog_dir>
            <FermionBC>
              <FermBC>SIMPLE_FERMBC</FermBC>
              <boundary>1 1 1 -1</boundary>
            </FermionBC>
          </FermState>
        </FermionAction>
        <num_flavors>1</num_flavors>
        <NamedObject><monomial_id>HMC::logdet_strange</monomial_id></NamedObject>
      </elem>

      <elem>
        <Name>TWO_FLAVOR_EOPREC_CONSTDET_FERM_MONOMIAL</Name>
        <InvertParam>
          <invType>CG_INVERTER</invType>
          <RsdCG>1.0e-9</RsdCG>
          <MaxCG>10000</MaxCG>
        </InvertParam>
        <FermionAction>
          <FermAct>CLOVER</FermAct>
          <Mass>-0.2450</Mass>
          <clovCoeff>1.24930970916466</clovCoeff>
          <AnisoParam>
            <anisoP>false</anisoP><t_dir>3</t_dir><xi_0>1</xi_0><nu>1</nu>
          </AnisoParam>
          <FermState>
            <Name>STOUT_FERM_STATE</Name>
            <rho>0.125</rho><n_smear>1</n_smear><orthog_dir>-1</orthog_dir>
            <FermionBC>
              <FermBC>SIMPLE_FERMBC</FermBC>
              <boundary>1 1 1 -1</boundary>
            </FermionBC>
          </FermState>
        </FermionAction>
        <ChronologicalPredictor>
          <Name>LAST_SOLUTION_4D_PREDICTOR</Name>
        </ChronologicalPredictor>
        <NamedObject><monomial_id>HMC::twoflav_light</monomial_id></NamedObject>
      </elem>

      <elem>
        <Name>ONE_FLAVOR_EOPREC_CONSTDET_FERM_RAT_MONOMIAL</Name>
        <num_pf>1</num_pf>
        <Action>
          <FermionAction>
            <FermAct>CLOVER</FermAct>
            <Mass>-0.2450</Mass>
            <clovCoeff>1.24930970916466</clovCoeff>
            <AnisoParam>
              <anisoP>false</anisoP><t_dir>3</t_dir><xi_0>1</xi_0><nu>1</nu>
            </AnisoParam>
            <FermState>
              <Name>STOUT_FERM_STATE</Name>
              <rho>0.125</rho><n_smear>1</n_smear><orthog_dir>-1</orthog_dir>
              <FermionBC>
                <FermBC>SIMPLE_FERMBC</FermBC>
                <boundary>1 1 1 -1</boundary>
              </FermionBC>
            </FermState>
          </FermionAction>
          <ActionApprox>
            <RationalApprox>
              <ratApproxType>REMEZ</ratApproxType>
                <lowerMin>0.0001</lowerMin>
                <upperMax>32</upperMax>
                <numPower>-1</numPower>
                <denPower>4</denPower>
                <degree>15</degree>
            </RationalApprox>
            <InvertParam>
              <invType>CG_INVERTER</invType>
              <RsdCG>1.0e-9</RsdCG>
              <MaxCG>10000</MaxCG>
            </InvertParam>
          </ActionApprox>
          <ForceApprox>
            <RationalApprox>
              <ratApproxType>REMEZ</ratApproxType>
                <lowerMin>0.0001</lowerMin>
                <upperMax>32</upperMax>
                <numPower>-1</numPower>
                <denPower>2</denPower>
                <degree>15</degree>
            </RationalApprox>
            <InvertParam>
              <invType>CG_INVERTER</invType>
              <RsdCG>1.0e-9</RsdCG>
              <MaxCG>10000</MaxCG>
            </InvertParam>
          </ForceApprox>
        </Action>
        <NamedObject><monomial_id>HMC::rat_strange</monomial_id></NamedObject>
      </elem>

      <elem>
        <Name>GAUGE_MONOMIAL</Name>
        <GaugeAction>
          <Name>LW_TREE_GAUGEACT</Name>
          <beta>6.1</beta>
          <u0>0.832605301399891</u0>
          <GaugeBC><Name>PERIODIC_GAUGEBC</Name></GaugeBC>
        </GaugeAction>
        <NamedObject>
          <monomial_id>HMC::lw_tree_gauge</monomial_id>
        </NamedObject>
      </elem>

    </Monomials>

    <Hamiltonian>
      <monomial_ids>
        <elem>HMC::logdet_light</elem>
        <elem>HMC::logdet_strange</elem>
        <elem>HMC::twoflav_light</elem>
        <elem>HMC::rat_strange</elem>
        <elem>HMC::lw_tree_gauge</elem>
      </monomial_ids>
    </Hamiltonian>

    <MDIntegrator>
      <tau0>1.41421356237310</tau0>
      <Integrator>
        <Name>LCM_STS_MIN_NORM_2</Name>
        <n_steps>@MDS@</n_steps>
        <lambda>0.1789</lambda>
        <monomial_ids>
          <elem>HMC::logdet_light</elem>
          <elem>HMC::logdet_strange</elem>
          <elem>HMC::twoflav_light</elem>
          <elem>HMC::rat_strange</elem>
        </monomial_ids>
        <SubIntegrator>
          <Name>LCM_STS_MIN_NORM_2</Name>
          <n_steps>4</n_steps>
          <monomial_ids>
            <elem>HMC::lw_tree_gauge</elem>
          </monomial_ids>
        </SubIntegrator>
      </Integrator>
    </MDIntegrator>

    <nrow>16 16 16 48</nrow>
  </HMCTrj>
</Params>
